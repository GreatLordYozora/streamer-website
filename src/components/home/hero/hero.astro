---
import { Image } from "astro:assets";

import { heroData, heroNavData } from "../../../data/home/heroData";
import HeroNav from "./heroNav.astro";

const { description, image, subtitle, title, welcomeMessage } = heroData;
---

<section
  id="home"
  class="hero relative w-full overflow-hidden py-12 md:py-16 lg:py-24"
>
  <div
    class="hero-content container relative z-10 mx-auto flex max-w-7xl flex-col items-center justify-between gap-8 px-4 md:px-8 lg:flex-row lg:gap-12"
  >
    <div
      class="relative flex w-full flex-col justify-center text-center lg:w-1/2 lg:text-left"
    >
      <div
        class="mb-3 flex items-center justify-center gap-2 lg:justify-start"
      >
        <span
          class="inline-block size-2 animate-pulse rounded-full bg-secondary"
          aria-hidden="true"></span>
        <span
          class="font-mono text-xs font-bold uppercase tracking-widest text-primary md:text-sm"
        >
          // {welcomeMessage}
        </span>
      </div>

      <h1
        class="mb-4 font-mono text-4xl font-extrabold uppercase leading-tight tracking-tight drop-shadow-[0_0_10px_rgba(232,194,34,0.2)] md:text-5xl lg:mb-6 lg:text-6xl"
      >
        {title}
      </h1>

      <p
        class="mx-auto mb-3 max-w-2xl border-l-2 border-secondary pl-3 text-left font-mono text-xl font-semibold leading-snug opacity-90 md:text-2xl lg:mx-0 lg:mb-5 lg:border-l-4 lg:pl-4"
      >
        {subtitle}
      </p>

      <p
        class="mx-auto mb-8 max-w-2xl font-mono text-base leading-relaxed opacity-80 md:text-lg lg:mx-0 lg:mb-10"
      >
        {description}
      </p>

      <div class="flex justify-center lg:justify-start">
        <HeroNav links={heroNavData} />
      </div>
    </div>

    <div class="flex w-full items-center justify-center lg:w-1/2">
      <div class="relative w-full max-w-lg">
        <div
          class="pointer-events-none absolute -inset-2 rounded-xs border border-secondary/30"
          aria-hidden="true"
        >
        </div>

        <figure
          class="relative aspect-9/11 w-full overflow-hidden rounded-xs border border-primary/50 bg-base-200/80 shadow-[0_0_30px_rgba(232,194,34,0.15)] backdrop-blur-md"
        >
          <span
            class="absolute top-0 left-0 z-20 size-3 border-t-2 border-l-2 border-primary"
            aria-hidden="true"></span>
          <span
            class="absolute top-0 right-0 z-20 size-3 border-t-2 border-r-2 border-secondary"
            aria-hidden="true"></span>
          <span
            class="absolute bottom-0 left-0 z-20 size-3 border-b-2 border-l-2 border-secondary"
            aria-hidden="true"></span>
          <span
            class="absolute bottom-0 right-0 z-20 size-3 border-b-2 border-r-2 border-primary"
            aria-hidden="true"></span>

          <Image
            src={image}
            alt={`Fotografía principal de ${title}`}
            width={600}
            height={733}
            fetchpriority="high"
            class="h-full w-full object-cover object-center"
          />

          <div
            class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(to_bottom,transparent_50%,rgba(0,0,0,0.5)_51%)] bg-size-[100%_4px] opacity-40"
            aria-hidden="true"
          >
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>