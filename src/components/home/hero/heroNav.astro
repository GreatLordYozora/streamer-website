---
import { Icon } from "astro-icon/components";

export interface LinkItem {
  icon: string;
  text: string;
  url: string;
}

export interface Props {
  links: LinkItem[];
}

const { links = [] } = Astro.props;
---

<nav aria-label="Enlaces rápidos del Hero" class="flex w-full flex-wrap gap-3">
  {
    links.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-1 min-w-full items-center justify-between overflow-hidden rounded-xs border border-primary/40 bg-base-200/90 px-5 py-4 text-base-content backdrop-blur-sm transition-all duration-300 hover:border-primary hover:shadow-[0_0_20px_rgba(232,194,34,0.3)] sm:min-w-[calc(50%-0.75rem)] lg:min-w-[calc(50%-0.75rem)]"
      >
        <span
          class="absolute top-0 left-0 z-10 size-2 border-t-2 border-l-2 border-primary transition-transform group-hover:scale-125"
          aria-hidden="true"
        />
        <span
          class="absolute top-0 right-0 z-10 size-2 border-t-2 border-r-2 border-secondary transition-transform group-hover:scale-125"
          aria-hidden="true"
        />
        <span
          class="absolute bottom-0 left-0 z-10 size-2 border-b-2 border-l-2 border-secondary transition-transform group-hover:scale-125"
          aria-hidden="true"
        />
        <span
          class="absolute bottom-0 right-0 z-10 size-2 border-b-2 border-r-2 border-primary transition-transform group-hover:scale-125"
          aria-hidden="true"
        />

        <div
          class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,transparent_50%,rgba(0,0,0,0.4)_51%)] bg-size-[100%_4px] opacity-20"
          aria-hidden="true"
        />

        <div class="relative z-10 flex min-w-0 flex-1 items-center gap-3.5">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-xs border border-primary/30 bg-base-100/80 text-primary transition-colors duration-300 group-hover:bg-primary group-hover:text-base-100">
            <Icon name={link.icon} class="size-5 shrink-0" aria-hidden="true" />
          </div>

          <div class="min-w-0 flex-1 text-left">
            <span class="font-mono text-base font-bold uppercase leading-snug tracking-wider text-wrap text-base-content transition-colors group-hover:text-primary">
              {link.text}
            </span>
          </div>
        </div>

        <div class="relative z-10 ml-auto shrink-0 rounded-xs border border-primary/30 bg-base-100/40 p-1.5 transition-all duration-300 group-hover:translate-x-1 group-hover:border-primary group-hover:bg-primary/20">
          <Icon
            name="miscellaneous/chevron-right"
            class="size-4 shrink-0 text-primary"
            aria-hidden="true"
          />
        </div>
      </a>
    ))
  }
</nav>
