---
import { Icon } from "astro-icon/components";

import { discordData } from "../../../data/home/discordData";

const { buttonTitle, subtitle, title, url } = discordData;
---

<section
  class="relative w-full overflow-hidden border-y border-base-300 bg-base-200/30 py-12 md:py-16 lg:py-24"
>
  <div class="relative z-10 mx-auto max-w-7xl px-4 md:px-8">
    <div class="relative mx-auto mb-8 max-w-2xl text-center md:mb-12">
      <h2
        class="mb-3 font-mono text-3xl font-extrabold uppercase tracking-widest text-base-content drop-shadow-[0_0_8px_rgba(88,101,242,0.2)] md:mb-4 md:text-4xl lg:text-5xl"
      >
        {title}
      </h2>
      <p class="font-mono text-base leading-relaxed opacity-80 md:text-lg">
        {subtitle}
      </p>
    </div>

    <div class="flex w-full items-center justify-center">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${buttonTitle} - Servidor de Discord`}
        class="group relative flex items-center justify-center gap-3 overflow-hidden rounded-xs border border-[#5865F2]/50 bg-[#5865F2]/10 px-8 py-4 backdrop-blur-md transition-all duration-300 hover:border-[#5865F2] hover:bg-[#5865F2]/20 hover:shadow-[0_0_25px_rgba(88,101,242,0.4)] sm:px-10 sm:py-5"
      >
        <span
          class="absolute top-0 left-0 size-2.5 border-t-2 border-l-2 border-[#5865F2] transition-transform group-hover:scale-125"
          aria-hidden="true"></span>
        <span
          class="absolute top-0 right-0 size-2.5 border-t-2 border-r-2 border-[#5865F2] transition-transform group-hover:scale-125"
          aria-hidden="true"></span>
        <span
          class="absolute bottom-0 left-0 size-2.5 border-b-2 border-l-2 border-[#5865F2] transition-transform group-hover:scale-125"
          aria-hidden="true"></span>
        <span
          class="absolute bottom-0 right-0 size-2.5 border-b-2 border-r-2 border-[#5865F2] transition-transform group-hover:scale-125"
          aria-hidden="true"></span>

        <span
          class="absolute top-1/4 left-0 h-1/2 w-0.5 bg-[#5865F2]/50 transition-all duration-300 group-hover:h-3/4 group-hover:bg-[#5865F2]"
          aria-hidden="true"></span>

        <div
          class="relative z-10 flex items-center gap-3 text-[#5865F2] transition-colors group-hover:text-white"
        >
          <Icon
            name="social/discord"
            class="size-6 shrink-0 drop-shadow-[0_0_5px_rgba(88,101,242,0.5)] transition-all group-hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.8)] sm:size-7"
            aria-hidden="true"
          />
          <span
            class="font-mono text-sm font-bold uppercase tracking-widest sm:text-base"
          >
            {buttonTitle}
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
