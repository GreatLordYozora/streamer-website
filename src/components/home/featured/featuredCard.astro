---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import type { FeaturedCard as FeaturedCardType } from "../../../data/home/featuredData";

export interface Props {
  card: FeaturedCardType;
}

const { card } = Astro.props;
---

<a
  href={card.platformUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative flex w-full flex-col overflow-hidden rounded-xs border border-primary/40 bg-base-200/90 text-base-content backdrop-blur-xs transition-all duration-300 hover:border-primary hover:shadow-[0_0_25px_rgba(232,194,34,0.35)]"
>
  <span
    class="absolute top-0 left-0 z-20 size-2 border-t-2 border-l-2 border-primary transition-transform group-hover:scale-125"
    aria-hidden="true"></span>
  <span
    class="absolute top-0 right-0 z-20 size-2 border-t-2 border-r-2 border-secondary transition-transform group-hover:scale-125"
    aria-hidden="true"></span>
  <span
    class="absolute bottom-0 left-0 z-20 size-2 border-b-2 border-l-2 border-secondary transition-transform group-hover:scale-125"
    aria-hidden="true"></span>
  <span
    class="absolute bottom-0 right-0 z-20 size-2 border-b-2 border-r-2 border-primary transition-transform group-hover:scale-125"
    aria-hidden="true"></span>

  <div class="relative aspect-video w-full overflow-hidden">
    <Image
      src={card.backgroundImage}
      alt={`Miniatura del proyecto destacado: ${card.title}`}
      width={640}
      height={360}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />

    <div
      class="absolute inset-0 bg-linear-to-t from-base-100/90 via-base-100/20 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,transparent_50%,rgba(0,0,0,0.5)_51%)] bg-size-[100%_4px] opacity-30"
      aria-hidden="true"
    >
    </div>

    <div class="absolute top-5 right-5 left-5">
      <span
        class="badge badge-neutral rounded-xs border border-secondary/50 px-3 py-2.5 font-mono text-[10px] uppercase tracking-widest text-secondary"
      >
        {card.type}
      </span>
    </div>

    <div class="absolute right-2 bottom-2">
      <span
        class="badge badge-neutral rounded-xs border border-primary/50 px-3 py-2.5 font-mono text-[10px] uppercase tracking-widest text-primary"
      >
        {card.duration}
      </span>
    </div>
  </div>

  <div class="relative z-20 space-y-2 p-5">
    <div
      class="flex items-start justify-between gap-2 border-l-2 border-primary/80 pl-3"
    >
      <h3
        class="font-mono text-xl font-extrabold uppercase tracking-wide transition-colors group-hover:text-primary"
      >
        {card.title}
      </h3>

      <div
        class="shrink-0 rounded-xs border border-primary/40 bg-base-100/50 p-1.5 backdrop-blur-md transition-all duration-300 group-hover:translate-x-1 group-hover:border-primary group-hover:bg-primary/20"
      >
        <Icon
          name="miscellaneous/chevron-right"
          class="size-4 text-primary"
          aria-hidden="true"
        />
      </div>
    </div>

    <p
      class="line-clamp-2 pl-3 font-mono text-xs leading-relaxed opacity-80 md:text-sm"
    >
      {card.description}
    </p>
  </div>
</a>