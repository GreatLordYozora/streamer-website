---
import { linksData } from "../../../data/home/linksData";
import LinkButton from "./linkButton.astro";

const { subsections = [], subtitle, title } = linksData;
---

<section class="relative w-full overflow-hidden py-12 md:py-16 lg:py-24">
  <div class="container relative z-10 mx-auto max-w-7xl px-4 md:px-8">
    <header class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
      <h2
        class="mb-3 font-mono text-3xl font-extrabold uppercase tracking-widest text-base-content drop-shadow-[0_0_10px_rgba(232,194,34,0.2)] md:mb-4 md:text-4xl lg:text-5xl"
      >
        {title}
      </h2>
      <p class="font-mono text-base leading-relaxed opacity-80 md:text-lg">
        {subtitle}
      </p>
    </header>

    <div class="space-y-12 md:space-y-16">
      {
        subsections.map((subsection) => (
          <div class="w-full">
            <div class="mb-6 flex items-center gap-4 md:mb-8">
              <span
                class="h-px flex-1 bg-linear-to-r from-transparent via-primary/40 to-primary"
                aria-hidden="true"
              />
              <h3 class="text-wrap px-2 font-mono text-xl font-bold uppercase tracking-widest text-secondary drop-shadow-[0_0_5px_rgba(0,240,255,0.3)] md:text-2xl">
                // {subsection.title}
              </h3>
              <span
                class="h-px flex-1 bg-linear-to-l from-transparent via-primary/40 to-primary"
                aria-hidden="true"
              />
            </div>

            <div class="flex w-full flex-wrap gap-4">
              {subsection.links.map((link) => (
                <LinkButton link={link} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>