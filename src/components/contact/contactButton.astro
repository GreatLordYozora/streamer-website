---
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
  title: string;
  description: string;
  icon: string;
  index: number;
}

const { id, title, description, icon, index } = Astro.props;
---

<button
  type="button"
  onclick={`document.getElementById('modal_${id}').showModal()`}
  class="group relative flex aspect-square w-full cursor-pointer flex-col items-start justify-between overflow-hidden border border-primary/30 bg-base-200/50 p-5 text-left backdrop-blur-md transition-all duration-300 rounded-xs md:p-6 hover:border-primary hover:bg-base-200/90 hover:shadow-[0_0_20px_rgba(232,194,34,0.25)] focus:outline-none focus:ring-1 focus:ring-primary"
>
  <span
    class="absolute top-0 right-0 size-3 border-t-2 border-r-2 border-secondary/0 transition-all duration-300 group-hover:border-secondary"
    aria-hidden="true"></span>
  <span
    class="absolute bottom-0 left-0 size-3 border-b-2 border-l-2 border-primary/0 transition-all duration-300 group-hover:border-primary"
    aria-hidden="true"></span>

  <span
    class="absolute top-1/4 left-0 h-1/2 w-0.75 bg-primary/20 transition-all duration-300 group-hover:h-3/4 group-hover:bg-primary"
    aria-hidden="true"></span>

  <div class="z-10 flex w-full shrink-0 items-start justify-between">
    <div
      class="flex size-11 items-center justify-center border border-primary/40 bg-base-100 text-primary transition-all duration-300 rounded-xs md:size-12 group-hover:scale-105 group-hover:bg-primary group-hover:text-base-100 group-hover:shadow-[0_0_15px_rgba(232,194,34,0.4)]"
    >
      <Icon name={icon} class="size-5 shrink-0 md:size-6" aria-hidden="true" />
    </div>
    <span
      class="font-mono text-xs font-bold tracking-widest text-secondary opacity-80 group-hover:opacity-100"
    >
      // {String(index + 1).padStart(2, "0")}
    </span>
  </div>

  <div class="z-10 my-3 flex w-full flex-1 flex-col justify-center space-y-2">
    <h2
      class="font-mono text-lg font-extrabold uppercase leading-tight tracking-wide text-base-content transition-colors md:text-xl group-hover:text-primary"
    >
      {title}
    </h2>
    <p class="line-clamp-3 font-mono text-xs leading-relaxed opacity-70">
      {description}
    </p>
  </div>

  <div
    class="z-10 flex w-full shrink-0 items-center justify-between border-t border-primary/15 pt-3 font-mono text-xs font-bold text-primary opacity-80 transition-colors group-hover:border-primary/40 group-hover:opacity-100"
  >
    <span class="tracking-wider">[ DEPLOY_FORM ]</span>
    <Icon
      name="miscellaneous/chevron-right"
      class="size-4 transform transition-transform group-hover:translate-x-1 group-hover:text-secondary"
      aria-hidden="true"
    />
  </div>
</button>
