---
import { Icon } from "astro-icon/components";

export interface ButtonItem {
  icon: string;
  title: string;
  url: string;
}

export interface Props {
  button: ButtonItem[];
}

const { button = [] } = Astro.props;
---

<nav aria-label="Redes Sociales" class="flex flex-row gap-2">
  {
    button.map(({ icon, title, url }) => (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={title}
        class="btn btn-xs rounded-xs border border-primary/40 bg-base-100/60 text-primary transition-all duration-300 hover:border-primary hover:bg-primary hover:text-base-100 md:btn-sm"
      >
        <Icon
          name={icon}
          class="size-4 shrink-0 transition-transform duration-200 hover:scale-110"
          aria-hidden="true"
        />
      </a>
    ))
  }
</nav>
